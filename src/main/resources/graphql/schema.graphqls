type User {
  id: ID!
  name: String!
  email: String!
}

type Query {
  users: [User]
  reactiveUsers: [User]
  userById(id: ID!): User
  getUser(id: ID!): User
}

type Mutation {
  createUser(name: String!, email: String!): User
  createReactiveUser(name: String!, email: String!): User
  deleteUser(id: ID!): Boolean

}
