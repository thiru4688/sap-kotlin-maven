type Users {
  id: ID
  name: String
  email: String
}

type Query {
  users: [Users]
  allUsers: [Users]
  userById(id: Int): Users

}

type Mutation {
  createUser(id: Int, name: String, email: String): Users
  updateUser(id: Int!, name: String!, email: String!): Users
  deleteUser(id: Int): Boolean
}